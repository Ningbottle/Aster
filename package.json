{
  "name": "aster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/desktop/main/index.cjs",
  "scripts": {
    "postinstall": "bun install --cwd vendor/thinkrail --frozen-lockfile",
    "dev:desktop": "npm run build:desktop && electron .",
    "dev:host": "bun src/host/index.ts",
    "install:host": "bun install --cwd vendor/thinkrail --frozen-lockfile",
    "build:desktop": "electron-vite build",
    "check:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "test:host": "bun test tests/host/",
    "test:ui": "node scripts/dev/desktop-ui-check.mjs",
    "lint:nofake": "node scripts/ci/no-fake-data.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun": "1.4.4",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
