{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"], "types": ["node"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "esModuleInterop": true, "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "paths": { "@thinkrail/contracts": ["./vendor/thinkrail/packages/contracts/src/index.ts"] }
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/renderer/**/*.ts", "src/renderer/**/*.tsx", "tests/renderer/**/*.ts", "tests/main/**/*.ts", "tests/desktop/**/*.tsx", "electron.vite.config.ts", "vitest.desktop.config.ts"]
}
